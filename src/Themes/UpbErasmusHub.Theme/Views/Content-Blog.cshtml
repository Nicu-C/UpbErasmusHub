@using OrchardCore.ContentManagement

@{
    ContentItem contentItem = Model.ContentItem;
}

<!-- Google Fonts & Bootstrap 5 + Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --upb-blue: #0b2545;
        --upb-blue-dark: #07192f;
        --upb-accent: #0077b6;
        --upb-gold: #ffb703;
        --upb-bg: #f8fafc;
    }

    body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
        background-color: var(--upb-bg);
        color: #1e293b;
        margin: 0;
        padding: 0;
    }

    /* Suppress Orchard's raw unstyled part wrappers */
    .field-name-blog-banner-image,
    img[src*="Default/is-cache"],
    .field-name-blog-description {
        display: none !important;
    }

    /* Top Utility Navbar */
    .portal-nav {
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.85rem 0;
    }

    .portal-brand {
        font-weight: 800;
        font-size: 1.25rem;
        color: var(--upb-blue);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .portal-brand span {
            color: var(--upb-accent);
        }

    /* Hero Section */
    .erasmus-hero {
        background: linear-gradient(135deg, var(--upb-blue-dark) 0%, var(--upb-blue) 60%, #133b68 100%);
        color: #ffffff;
        padding: 5rem 0 4.5rem;
        position: relative;
        overflow: hidden;
    }

        .erasmus-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 80% 20%, rgba(0, 119, 182, 0.25) 0%, transparent 60%);
            pointer-events: none;
        }

    .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--upb-gold);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.45rem 1rem;
        border-radius: 50rem;
    }

    .hero-title {
        font-size: 3.25rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
    }

    .hero-subtitle {
        color: #cbd5e1;
        font-size: 1.15rem;
        line-height: 1.6;
        max-width: 680px;
        margin: 0 auto;
    }

    /* Quick Stat / Highlights Grid */
    .stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 20px -3px rgba(0,0,0,0.08);
        }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }

    /* Content Cards */
    .portal-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);
    }

    .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 1.75rem;
    }

    .section-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--upb-blue);
        margin: 0;
    }

    /* Clean overrides for standard Orchard blog items */
    .post-preview {
        padding: 1.5rem 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .post-preview:last-child {
            border-bottom: none;
        }

        .post-preview a {
            text-decoration: none;
        }

    .post-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--upb-blue);
        margin-bottom: 0.4rem;
        transition: color 0.15s ease;
    }

    .post-preview:hover .post-title {
        color: var(--upb-accent);
    }

    .post-subtitle {
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
    }

    .post-meta {
        font-size: 0.8rem;
        color: #94a3b8;
    }
</style>

<!-- Modern Navbar -->
<nav class="portal-nav sticky-top">
    <div class="container px-4 px-lg-5 d-flex justify-content-between align-items-center">
        <a href="/" class="portal-brand">
            <i class="bi bi-mortarboard-fill text-primary"></i>
            UPB <span>Erasmus+</span>
        </a>
        <div class="d-flex align-items-center gap-2">
            <a href="/admin" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                <i class="bi bi-person-fill-lock me-1"></i> Admin
            </a>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<header class="erasmus-hero text-center">
    <div class="container px-4 px-lg-5 position-relative">
        <div class="hero-pill mb-3">
            <i class="bi bi-globe-americas"></i>
            National University of Science and Technology POLITEHNICA Bucharest
        </div>
        <h1 class="hero-title mb-3">Erasmus+ Mobility Hub</h1>
        <p class="hero-subtitle mb-4">
            Connect with top universities across Europe, submit applications, and stay informed with essential announcements.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="#announcements" class="btn btn-warning btn-lg px-4 fw-bold rounded-pill shadow-sm" style="background-color: var(--upb-gold); border: none;">
                <i class="bi bi-newspaper me-1"></i> Announcements
            </a>
            <a href="#quick-access" class="btn btn-outline-light btn-lg px-4 fw-semibold rounded-pill">
                Explore Programs
            </a>
        </div>
    </div>
</header>

<!-- Quick Action Highlights -->
<section class="container px-4 px-lg-5 my-5" id="quick-access">
    <div class="row g-4">

        <!-- Partner Universities Card (Linked) -->
        <div class="col-md-4">
            <a href="/universities" class="text-decoration-none">
                <div class="stat-card h-100 transition-hover">
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-buildings"></i>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-1">Partner Universities</h3>
                    <p class="text-muted small mb-0">Browse accredited European higher education partners mapped for your faculty.</p>
                </div>
            </a>
        </div>

        <!-- Application Steps Card (Linked) -->
        <div class="col-md-4">
            <a href="/application-steps" class="text-decoration-none">
                <div class="stat-card h-100 transition-hover">
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>
                    <h3 class="h5 fw-bold text-dark mb-1">Application Steps</h3>
                    <p class="text-muted small mb-0">Review selection criteria, required language certifications, and application periods.</p>
                </div>
            </a>
        </div>


        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-journal-text"></i>
                </div>
                <h3 class="h5 fw-bold text-dark mb-1">Student Stories</h3>
                <p class="text-muted small mb-0">Read genuine feedback and advice from alumni who completed an exchange semester.</p>
            </div>
        </div>
    </div>
</section>

<!-- Content / Announcements Feed -->
<main class="container px-4 px-lg-5 my-5" id="announcements">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="section-header">
                <div>
                    <h2 class="section-title">Latest Announcements</h2>
                    <span class="text-muted small">Official notices from the UPB International Relations Office</span>
                </div>
            </div>

            <div class="portal-card p-4 p-md-5">
                @if (Model.Content.BlogPostList != null)
                {
                    @await DisplayAsync(Model.Content.BlogPostList)
                }
                else
                {
                    @await DisplayAsync(Model.Content)
                }
            </div>
        </div>
    </div>
</main>