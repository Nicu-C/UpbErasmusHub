@using OrchardCore.ContentManagement

@{
    ContentItem contentItem = Model.ContentItem;
    var title = contentItem.DisplayText;
    var publishedUtc = contentItem.CreatedUtc?.ToString("MMMM dd, yyyy") ?? "Recent";
    var author = contentItem.Author ?? "UPB Erasmus+ Office";
}

<!-- External Stylesheets (if Layout doesn't include them) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --upb-blue: #0b2545;
        --upb-blue-dark: #07192f;
        --upb-accent: #0077b6;
        --upb-gold: #ffb703;
        --upb-bg: #f8fafc;
    }

    body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
        background-color: var(--upb-bg);
        color: #1e293b;
        margin: 0;
        padding: 0;
    }

    .post-hero {
        background: linear-gradient(135deg, var(--upb-blue-dark) 0%, var(--upb-blue) 65%, #133b68 100%);
        color: #ffffff;
        padding: 4rem 0 3.5rem;
    }

    .article-container {
        max-width: 860px;
        margin: -2rem auto 4rem;
        background: #ffffff;
        border-radius: 1rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
        padding: 2.5rem 3rem;
    }

    .article-content {
        font-size: 1.05rem;
        line-height: 1.75;
        color: #334155;
    }

        .article-content h3 {
            color: var(--upb-blue);
            font-weight: 700;
            margin-top: 2rem;
            margin-bottom: 1rem;
        }

        .article-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.5rem 0;
        }

            .article-content table th {
                background-color: #f1f5f9;
                color: var(--upb-blue);
                font-weight: 600;
                padding: 0.75rem 1rem;
                border: 1px solid #cbd5e1;
            }

            .article-content table td {
                padding: 0.75rem 1rem;
                border: 1px solid #cbd5e1;
            }

        .article-content blockquote {
            border-left: 4px solid var(--upb-accent);
            padding: 0.75rem 1.25rem;
            background: #f8fafc;
            border-radius: 0.5rem;
            margin: 1.5rem 0;
            font-style: italic;
        }
</style>

<!-- Top Hero Header -->
<header class="post-hero text-center">
    <div class="container px-4 px-lg-5">
        <a href="/" class="btn btn-sm btn-outline-light rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Home
        </a>
        <h1 class="display-6 fw-bold mb-2">@title</h1>
        <div class="text-light opacity-75 small">
            <i class="bi bi-person-fill me-1"></i> @author &nbsp;|&nbsp;
            <i class="bi bi-calendar3 me-1"></i> @publishedUtc
        </div>
    </div>
</header>

<!-- Article Body Content -->
<main class="container px-3 px-md-4">
    <article class="article-container">
        <div class="article-content">
            @await DisplayAsync(Model.Content)
        </div>
    </article>
</main>