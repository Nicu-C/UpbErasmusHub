@model UpbErasmusHub.Core.ViewModels.ReviewCatalogViewModel
@using OrchardCore.ContentManagement

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="text-white py-5 mb-5" style="background: linear-gradient(135deg, #07192f 0%, #0b2545 100%);">
    <div class="container text-center">
        <a href="/" class="btn btn-sm btn-outline-light rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Home
        </a>
        <h1 class="display-4 fw-bold">Erasmus+ Student Stories & Reviews</h1>
        <p class="lead text-light opacity-75 max-w-700 mx-auto">
            Read authentic feedback, monthly living cost estimates, and housing advice shared by alumni who completed an exchange semester.
        </p>
        <div class="mt-4">
            <a href="/reviews/submit" class="btn btn-warning fw-semibold rounded-pill px-4 shadow-sm">
                <i class="bi bi-chat-square-text-fill me-1"></i> Share Your Experience
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (!Model.Reviews.Any())
    {
        <div class="alert alert-info p-4 text-center">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            No student reviews have been published yet. Be the first to share your Erasmus story!
        </div>
    }
    else
    {
        <div class="row g-4 justify-content-center">
            @foreach (var item in Model.Reviews)
            {
                var part = item.Content.StudentReviewPart;
                string studentName = part?.StudentName?.Text?.ToString() ?? "Anonymous Student";
                string semester = part?.MobilitySemester?.Text?.ToString() ?? "Exchange Semester";
                int rating = part?.OverallRating?.Value != null ? (int)part.OverallRating.Value : 5;
                int livingCost = part?.MonthlyLivingCost?.Value != null ? (int)part.MonthlyLivingCost.Value : 650;
                string housing = part?.HousingAdvice?.Text?.ToString() ?? "";
                string comments = part?.ReviewComments?.Text?.ToString() ?? "";

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-4 p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h3 class="h5 fw-bold text-dark mb-0">@studentName</h3>
                                <span class="text-muted small">@semester</span>
                            </div>
                            <span class="badge bg-warning text-dark fw-bold px-2.5 py-1.5 fs-6">
                                ★ @rating/5
                            </span>
                        </div>

                        <div class="mb-3">
                            <span class="badge bg-success-subtle text-success">
                                <i class="bi bi-wallet2 me-1"></i> ~€@livingCost / month
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(housing))
                        {
                            <div class="mb-3 p-3 bg-light rounded-3 small">
                                <strong class="text-dark d-block mb-1"><i class="bi bi-house-door me-1"></i> Housing Advice:</strong>
                                <span class="text-muted">@housing</span>
                            </div>
                        }

                        <div class="text-dark small fst-italic mb-3 flex-grow-1">
                            "@comments"
                        </div>

                        <div class="mt-auto pt-3 border-top text-muted small">
                            <i class="bi bi-check-circle-fill text-primary me-1"></i> Verified Exchange Student
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>