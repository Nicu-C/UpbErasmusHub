@{
    ViewLayout = "_Layout";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --upb-blue: #0b2545;
        --upb-blue-dark: #07192f;
        --upb-accent: #0077b6;
        --upb-gold: #ffb703;
        --upb-bg: #f8fafc;
    }

    body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
        background-color: var(--upb-bg);
        color: #1e293b;
    }

    .about-hero {
        background: linear-gradient(135deg, var(--upb-blue-dark) 0%, var(--upb-blue) 65%, #133b68 100%);
        color: #ffffff;
        padding: 4.5rem 0 3.5rem;
    }

    .info-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);
        padding: 2rem;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .info-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px -3px rgba(0,0,0,0.08);
        }

    .icon-badge {
        width: 48px;
        height: 48px;
        border-radius: 0.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 1.25rem;
    }
</style>

<!-- Hero Banner -->
<header class="about-hero text-center mb-5">
    <div class="container px-4 px-lg-5">
        <a href="/" class="btn btn-sm btn-outline-light rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Home
        </a>
        <h1 class="display-5 fw-bold mb-3">Erasmus+ at POLITEHNICA Bucharest</h1>
        <p class="lead text-light opacity-75 max-w-700 mx-auto" style="max-width: 720px;">
            The European Union program supporting education, training, youth, and sport in Europe, offering life-changing academic mobility opportunities to UPB students.
        </p>
    </div>
</header>

<main class="container px-4 px-lg-5 pb-5">
    <!-- General Overview -->
    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="info-card">
                <div class="icon-badge bg-primary-subtle text-primary">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h2 class="h4 fw-bold text-dark mb-3">What is Erasmus+ Study Mobility (SMS)?</h2>
                <p class="text-muted mb-3">
                    Erasmus+ Study Mobility allows undergraduate, master's, and doctoral students enrolled at National University of Science and Technology POLITEHNICA Bucharest to study for a semester or full academic year at one of our bilateral partner universities across the EU and associated countries.
                </p>
                <p class="text-muted mb-0">
                    Courses completed abroad are fully recognized towards your UPB degree through the European Credit Transfer and Accumulation System (ECTS) via your agreed <strong>Learning Agreement</strong>.
                </p>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="info-card">
                <div class="icon-badge bg-warning-subtle text-warning">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <h2 class="h4 fw-bold text-dark mb-3">Erasmus+ Financial Grants</h2>
                <p class="text-muted mb-3">
                    Every selected participant receives an EU financial grant designed to help cover travel and living expenses. Monthly allowances are standardized based on destination country living costs:
                </p>
                <ul class="text-muted small mb-0 ps-3">
                    <li class="mb-1"><strong>Group 1 (Higher living costs):</strong> ~€600 - €670 / month (e.g., Germany, France, Denmark, Sweden)</li>
                    <li class="mb-1"><strong>Group 2 (Medium living costs):</strong> ~€540 - €600 / month (e.g., Spain, Italy, Greece, Portugal)</li>
                    <li><strong>Group 3 (Lower living costs):</strong> ~€490 - €550 / month (e.g., Poland, Hungary, Bulgaria)</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Eligibility & Selection Criteria -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5 bg-white">
        <h2 class="h4 fw-bold text-dark mb-4">
            <i class="bi bi-check2-circle text-success me-2"></i>Eligibility & Selection Criteria
        </h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="border-start border-3 border-primary ps-3">
                    <h5 class="fw-bold text-dark mb-1">Academic Standing</h5>
                    <p class="text-muted small mb-0">
                        Must be officially enrolled at UPB and have completed at least the first year of Bachelor studies with passed all exams.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border-start border-3 border-primary ps-3">
                    <h5 class="fw-bold text-dark mb-1">Language Proficiency</h5>
                    <p class="text-muted small mb-0">
                        Minimum B2 level certification (or certificate issued by the UPB Department of Modern Languages) in English or the host country's language.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border-start border-3 border-primary ps-3">
                    <h5 class="fw-bold text-dark mb-1">Mobility Cap</h5>
                    <p class="text-muted small mb-0">
                        You can benefit from up to 12 months of Erasmus+ mobility per study cycle (Bachelor, Master, or PhD).
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact & Helpful Links -->
    <div class="row g-4 justify-content-center text-center">
        <div class="col-lg-8">
            <h3 class="h5 fw-bold text-dark mb-2">UPB International Relations Office</h3>
            <p class="text-muted small mb-3">
                Rectorate Building, Splaiul Independenței 313, Sector 6, Bucharest<br>
                Email: <a href="mailto:international@upb.ro" class="text-primary text-decoration-none">erasmus@upb.ro</a>
            </p>
            <div class="d-flex justify-content-center">
                <a href="https://upb.ro/en/erasmus/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5 fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-up-right"></i> Official UPB Portal
                </a>
            </div>
        </div>
    </div>
</main>