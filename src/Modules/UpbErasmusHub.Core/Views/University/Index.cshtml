@model UpbErasmusHub.Core.ViewModels.UniversityCatalogViewModel
@using OrchardCore.ContentManagement
@using UpbErasmusHub.Core.Models

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="text-white py-5 mb-4" style="background: linear-gradient(135deg, #07192f 0%, #0b2545 100%);">
    <div class="container">
        <a href="/" class="btn btn-sm btn-outline-light rounded-pill mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Home
        </a>
        <h1 class="display-5 fw-bold">Partner Universities Directory</h1>
        <p class="lead text-light opacity-75 mb-0">
            Search and filter @Model.TotalCount accredited Erasmus+ destinations.
        </p>
    </div>
</div>

<div class="container pb-5">
    <!-- Search & Filter Form -->
    <form method="get" action="/universities" class="card shadow-sm border-0 p-4 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-uppercase text-muted">Search Keyword</label>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="University, city, or code..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-uppercase text-muted">Country</label>
                <select name="country" class="form-select">
                    <option value="">All Countries</option>
                    @foreach (var country in Model.AvailableCountries)
                    {
                        <option value="@country" selected="@(Model.SelectedCountry == country)">@country</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-uppercase text-muted">Language Level</label>
                <select name="language" class="form-select">
                    <option value="">Any Level</option>
                    <option value="B1" selected="@(Model.SelectedLanguageLevel == "B1")">B1</option>
                    <option value="B2" selected="@(Model.SelectedLanguageLevel == "B2")">B2</option>
                    <option value="C1" selected="@(Model.SelectedLanguageLevel == "C1")">C1</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary fw-semibold">Filter</button>
            </div>
        </div>
    </form>

    <!-- Results Grid -->
    @if (!Model.Universities.Any())
    {
        <div class="alert alert-info p-4 text-center">
            No partner universities matched your criteria. Make sure you have published universities in the Admin panel!
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Universities)
            {
                var part = item.As<PartnerUniversityPart>();
                var slug = item.DisplayText?.ToLower().Replace(" ", "-") ?? "university";

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary">@part?.ErasmusCode</span>
                                <span class="badge bg-warning text-dark">Min. @part?.RequiredLanguageLevel</span>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-1">@item.DisplayText</h3>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @part?.City, @part?.Country
                            </p>
                            <div class="mt-auto pt-3">
                                <a href="/universities/@slug" class="btn btn-sm btn-primary rounded-pill w-100">
                                    View Details <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>