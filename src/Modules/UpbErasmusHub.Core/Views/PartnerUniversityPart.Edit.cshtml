@model UpbErasmusHub.Core.ViewModels.PartnerUniversityPartViewModel

<div class="card border p-3 mb-3">
    <h5 class="mb-3">Erasmus+ University Details</h5>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="ErasmusCode" class="form-label">Erasmus Code *</label>
            <input asp-for="ErasmusCode" class="form-control" placeholder="e.g., HU BUDAPES16" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Country" class="form-label">Country *</label>
            <input asp-for="Country" class="form-control" placeholder="e.g., Hungary" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="City" class="form-label">City *</label>
            <input asp-for="City" class="form-control" placeholder="e.g., Budapest" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="RequiredLanguageLevel" class="form-label">Language Level</label>
            <select asp-for="RequiredLanguageLevel" class="form-select">
                <option value="B1">B1 - Intermediate</option>
                <option value="B2">B2 - Upper Intermediate</option>
                <option value="C1">C1 - Advanced</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="AvailableSpots" class="form-label">Available Spots</label>
            <input asp-for="AvailableSpots" type="number" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="WebsiteUrl" class="form-label">Official Website URL</label>
            <input asp-for="WebsiteUrl" type="url" class="form-control" placeholder="https://uni-obuda.hu" />
        </div>
    </div>
</div>